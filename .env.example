# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT_STRING=%(levelname)s  [%(name)s] %(message)s
API_V1_BASE_URL=/api/v1
POSTGRES_DB=accessory_validator
POSTGRES_USER=accessory_validator
POSTGRES_PASSWORD=accessory_validator
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# LiteLLM is used by accessory validation. Supply your deployment values.
# Base URLs include the API version prefix, e.g. https://litellm.example.com/v1.
# Model lists are JSON arrays, tried in this exact order.
LITELLM_BASE_URL=
# LITELLM_API_KEY=
# Required client baseline; individual criteria override it per call when needed.
LITELLM_MODELS=["gpt-luna", "glm-5.3"]
# LITELLM_TIMEOUT_SECONDS=60
# LITELLM_TEMPERATURE=0.2
# LITELLM_MAX_TOKENS=1000
# Jev is initialized at application startup.
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_API_KEY=
TYPESAFE_MODELS=["jev-latest"]
# TYPESAFE_TIMEOUT_SECONDS=60
