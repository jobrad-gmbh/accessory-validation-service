# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT_STRING=%(levelname)s  [%(name)s] %(message)s
API_V1_BASE_URL=/api/v1

# LiteLLM gateway (required only by validations that use the LLM adapter)
# LLM_BASE_URL=https://llm-gateway.example.com/v1
# LLM_API_KEY=replace-with-a-secret
# LLM_MODEL=replace-with-a-model-name
LLM_TIMEOUT_SECONDS=60
