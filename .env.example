# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT_STRING=%(levelname)s  [%(name)s] %(message)s
API_V1_BASE_URL=/api/v1

# Optional standalone LLM clients. Uncomment and supply your deployment values.
# Base URLs include the API version prefix, e.g. https://api.openai.com/v1.
# Model lists are JSON arrays, tried in this exact order.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODELS=["your-primary-model", "your-backup-model"]
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_TOKENS=1000
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODELS=["your-primary-alias", "your-backup-alias"]
# LITELLM_TIMEOUT_SECONDS=60
# LITELLM_TEMPERATURE=0.2
# LITELLM_MAX_TOKENS=1000
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_API_KEY=
# TYPESAFE_MODELS=["jev-latest"]
# TYPESAFE_TIMEOUT_SECONDS=60
