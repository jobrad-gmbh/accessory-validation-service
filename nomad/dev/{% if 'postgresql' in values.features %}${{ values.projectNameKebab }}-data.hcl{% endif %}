namespace    = "${{ values.nomadNamespace }}"
id           = "${{ values.projectNameKebab }}-data"
name         = "${{ values.projectNameKebab }}-data"
capacity_min = "10GiB"
capacity_max = "10GiB"
plugin_id    = "csi-fws-cinder"
type         = "csi"

capability {
  access_mode     = "single-node-writer"
  attachment_mode = "file-system"
}

mount_options {
  fs_type     = "ext4"
  mount_flags = ["noatime"]
}

parameters = {
  type = "Basic" # 250 IOPS
}
